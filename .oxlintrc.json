{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "import", "jsx-a11y", "react"],
  "env": {
    "browser": true,
    "jest": true
  },
  "rules": {
    "import/no-anonymous-default-export": "off",
    "no-unused-vars": ["warn", { "args": "none", "caughtErrors": "none" }],
    "react/immutability": "off"
  }
}
